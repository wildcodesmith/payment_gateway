<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PCB Neon Processor Gateway</title>

  <!-- Tailwind CSS -->
    <link href="./src/output.css" rel="stylesheet">

  <!-- Google Fonts: Orbitron + Share Tech Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700;900&family=Share+Tech+Mono&display=swap" rel="stylesheet">

  <!-- razorpy endpoint -->
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

  <style>
    /* Continuous Normalized Electrical Spark Flowing OUTWARD from Card */
    @keyframes spark-outward {
      0% {
        stroke-dashoffset: 100;
      }
      100% {
        stroke-dashoffset: 0;
      }
    }

    .spark-line {
      stroke-dasharray: 18 82;
      animation: spark-outward 2.2s linear infinite;
      will-change: stroke-dashoffset;
    }

    .spark-line-fast {
      stroke-dasharray: 14 86;
      animation: spark-outward 1.6s linear infinite;
      will-change: stroke-dashoffset;
    }

    .spark-line-slow {
      stroke-dasharray: 22 78;
      animation: spark-outward 3.5s linear infinite;
      will-change: stroke-dashoffset;
    }

    /* Outer Card Neon Glow Animation */
    @keyframes neon-pulse {
      0%, 100% {
        box-shadow: 0 0 25px rgba(6, 182, 212, 0.4), inset 0 0 15px rgba(6, 182, 212, 0.2);
        border-color: rgba(34, 211, 238, 0.9);
      }
      50% {
        box-shadow: 0 0 45px rgba(6, 182, 212, 0.7), inset 0 0 25px rgba(6, 182, 212, 0.35);
        border-color: rgba(103, 232, 249, 1);
      }
    }

    .neon-chip-card {
      animation: neon-pulse 2.5s ease-in-out infinite;
      clip-path: polygon(
        24px 0, calc(100% - 24px) 0,
        100% 24px, 100% calc(100% - 24px),
        calc(100% - 24px) 100%, 24px 100%,
        0 calc(100% - 24px), 0 24px
      );
    }
  </style>
</head>

<body class="bg-black text-cyan-100 flex items-center justify-center min-h-screen p-4 overflow-x-hidden font-['Share_Tech_Mono'] selection:bg-cyan-500 selection:text-black">

  <!-- ULTRA-DENSE CYAN PCB CIRCUIT GRID (SPARKS FLOW OUTWARD) -->
  <div class="fixed inset-0 pointer-events-none opacity-85 flex items-center justify-center overflow-hidden">
    <svg class="w-[1400px] h-[900px] min-w-[1200px]" viewBox="0 0 1400 900" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="neon-cyan" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#67e8f9" />
          <stop offset="50%" stop-color="#22d3ee" />
          <stop offset="100%" stop-color="#0891b2" />
        </linearGradient>
      </defs>

      <!-- STATIC DENSE PCB CIRCUIT BUS TRACES (Smooth Arc Fillets at Turns) -->
      <g stroke="#0e3a43" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        
        <!-- Left Horizontal Bus Array -->
        <path d="M 450 450 L 50 450" />
        <path d="M 450 430 L 310 430 Q 295 430 285 420 L 260 390 Q 250 380 235 380 L 50 380" />
        <path d="M 450 410 L 330 410 Q 315 410 305 395 L 275 350 Q 265 340 250 340 L 50 340" />
        <path d="M 450 390 L 350 390 Q 335 390 325 375 L 295 310 Q 285 300 270 300 L 50 300" />
        <path d="M 450 370 L 370 370 Q 355 370 345 350 L 315 270 Q 305 260 290 260 L 50 260" />
        <path d="M 450 470 L 310 470 Q 295 470 285 480 L 260 510 Q 250 520 235 520 L 50 520" />
        <path d="M 450 490 L 330 490 Q 315 490 305 505 L 275 550 Q 265 560 250 560 L 50 560" />
        <path d="M 450 510 L 350 510 Q 335 510 325 525 L 295 585 Q 285 600 270 600 L 50 600" />
        <path d="M 450 530 L 370 530 Q 355 530 345 550 L 315 630 Q 305 640 290 640 L 50 640" />

        <!-- Right Horizontal Bus Array -->
        <path d="M 950 450 L 1350 450" />
        <path d="M 950 430 L 1090 430 Q 1105 430 1115 420 L 1140 390 Q 1150 380 1165 380 L 1350 380" />
        <path d="M 950 410 L 1070 410 Q 1085 410 1095 395 L 1125 350 Q 1135 340 1150 340 L 1350 340" />
        <path d="M 950 390 L 1050 390 Q 1065 390 1075 375 L 1105 310 Q 1115 300 1130 300 L 1350 300" />
        <path d="M 950 370 L 1030 370 Q 1045 370 1055 350 L 1085 270 Q 1095 260 1110 260 L 1350 260" />
        <path d="M 950 470 L 1090 470 Q 1105 470 1115 480 L 1140 510 Q 1150 520 1165 520 L 1350 520" />
        <path d="M 950 490 L 1070 490 Q 1085 490 1095 505 L 1125 550 Q 1135 560 1150 560 L 1350 560" />
        <path d="M 950 510 L 1050 510 Q 1065 510 1075 525 L 1105 585 Q 1115 600 1130 600 L 1350 600" />
        <path d="M 950 530 L 1030 530 Q 1045 530 1055 550 L 1085 630 Q 1095 640 1110 640 L 1350 640" />

        <!-- Top Vertical Bus Array -->
        <path d="M 700 200 L 700 30" />
        <path d="M 670 200 L 670 130 Q 670 115 660 105 L 630 75 Q 620 65 605 65 L 520 65" />
        <path d="M 640 200 L 640 150 Q 640 135 625 120 L 590 85 Q 575 75 560 75 L 400 75" />
        <path d="M 730 200 L 730 130 Q 730 115 740 105 L 770 75 Q 780 65 795 65 L 880 65" />
        <path d="M 760 200 L 760 150 Q 760 135 775 120 L 810 85 Q 825 75 840 75 L 1000 75" />

        <!-- Bottom Vertical Bus Array -->
        <path d="M 700 700 L 700 870" />
        <path d="M 670 700 L 670 770 Q 670 785 660 795 L 630 825 Q 620 835 605 835 L 520 835" />
        <path d="M 640 700 L 640 750 Q 640 765 625 780 L 590 815 Q 575 825 560 825 L 400 825" />
        <path d="M 730 700 L 730 770 Q 730 785 740 795 L 770 825 Q 780 835 795 835 L 880 835" />
        <path d="M 760 700 L 760 750 Q 760 765 775 780 L 810 815 Q 825 825 840 825 L 1000 825" />

      </g>

      <!-- ANIMATED SPARKS (PERFECT SMOOTH FLUIDITY WITH pathLength="100") -->
      <g stroke="url(#neon-cyan)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <!-- Left Sparks -->
        <path pathLength="100" d="M 450 450 L 50 450" class="spark-line-fast" />
        <path pathLength="100" d="M 450 430 L 310 430 Q 295 430 285 420 L 260 390 Q 250 380 235 380 L 50 380" class="spark-line" />
        <path pathLength="100" d="M 450 390 L 350 390 Q 335 390 325 375 L 295 310 Q 285 300 270 300 L 50 300" class="spark-line-slow" />
        <path pathLength="100" d="M 450 470 L 310 470 Q 295 470 285 480 L 260 510 Q 250 520 235 520 L 50 520" class="spark-line-fast" />
        <path pathLength="100" d="M 450 510 L 350 510 Q 335 510 325 525 L 295 585 Q 285 600 270 600 L 50 600" class="spark-line" />

        <!-- Right Sparks -->
        <path pathLength="100" d="M 950 450 L 1350 450" class="spark-line" />
        <path pathLength="100" d="M 950 430 L 1090 430 Q 1105 430 1115 420 L 1140 390 Q 1150 380 1165 380 L 1350 380" class="spark-line-fast" />
        <path pathLength="100" d="M 950 390 L 1050 390 Q 1065 390 1075 375 L 1105 310 Q 1115 300 1130 300 L 1350 300" class="spark-line" />
        <path pathLength="100" d="M 950 470 L 1090 470 Q 1105 470 1115 480 L 1140 510 Q 1150 520 1165 520 L 1350 520" class="spark-line-slow" />
        <path pathLength="100" d="M 950 510 L 1050 510 Q 1065 510 1075 525 L 1105 585 Q 1115 600 1130 600 L 1350 600" class="spark-line-fast" />

        <!-- Top Sparks -->
        <path pathLength="100" d="M 700 200 L 700 30" class="spark-line-fast" />
        <path pathLength="100" d="M 670 200 L 670 130 Q 670 115 660 105 L 630 75 Q 620 65 605 65 L 520 65" class="spark-line" />
        <path pathLength="100" d="M 730 200 L 730 130 Q 730 115 740 105 L 770 75 Q 780 65 795 65 L 880 65" class="spark-line-slow" />

        <!-- Bottom Sparks -->
        <path pathLength="100" d="M 700 700 L 700 870" class="spark-line" />
        <path pathLength="100" d="M 670 700 L 670 770 Q 670 785 660 795 L 630 825 Q 620 835 605 835 L 520 835" class="spark-line-fast" />
        <path pathLength="100" d="M 760 700 L 760 750 Q 760 765 775 780 L 810 815 Q 825 825 840 825 L 1000 825" class="spark-line" />
      </g>

      <!-- PCB Node Vias / Pads (Glowing Dots) -->
      <g fill="#22d3ee">
        <circle cx="450" cy="450" r="4" />
        <circle cx="450" cy="430" r="3" />
        <circle cx="450" cy="390" r="3" />
        <circle cx="450" cy="470" r="3" />
        <circle cx="450" cy="510" r="3" />

        <circle cx="950" cy="450" r="4" />
        <circle cx="950" cy="430" r="3" />
        <circle cx="950" cy="390" r="3" />
        <circle cx="950" cy="470" r="3" />
        <circle cx="950" cy="510" r="3" />

        <circle cx="700" cy="200" r="4" />
        <circle cx="700" cy="700" r="4" />
      </g>
    </svg>
  </div>

  <!-- Ambient Ambient Glow Backdrop -->
  <div class="fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[550px] bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <!--   NEON CHAMFERED PROCESSOR CARD  -->
  <div class="relative w-full max-w-md p-1 bg-cyan-400/80 neon-chip-card">

    <!-- Inner Card Container -->
    <div class="relative w-full bg-slate-950/95 backdrop-blur-2xl p-6 sm:p-8 font-['Share_Tech_Mono']">

      <!-- Left & Right Microchip Contact Pins -->
      <div class="absolute left-1.5 top-1/2 -translate-y-1/2 flex flex-col gap-2">
        <span class="w-1 h-3 bg-cyan-400 shadow-[0_0_8px_#22d3ee]"></span>
        <span class="w-1 h-3 bg-cyan-400/60"></span>
        <span class="w-1 h-3 bg-cyan-400 shadow-[0_0_8px_#22d3ee]"></span>
        <span class="w-1 h-3 bg-cyan-400/60"></span>
      </div>
      <div class="absolute right-1.5 top-1/2 -translate-y-1/2 flex flex-col gap-2">
        <span class="w-1 h-3 bg-cyan-400/60"></span>
        <span class="w-1 h-3 bg-cyan-400 shadow-[0_0_8px_#22d3ee]"></span>
        <span class="w-1 h-3 bg-cyan-400/60"></span>
        <span class="w-1 h-3 bg-cyan-400 shadow-[0_0_8px_#22d3ee]"></span>
      </div>

      <!-- Header Section -->
      <div class="mb-6 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-0.5 rounded bg-cyan-950/80 border border-cyan-400/60 text-[10px] text-cyan-300 mb-2 shadow-[0_0_10px_rgba(34,211,238,0.3)]">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-ping"></span>
          CPU_SOCKET // 0x2026
        </div>
        <h2 class="font-['Orbitron'] text-xl sm:text-2xl font-black tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 via-white to-cyan-400 uppercase drop-shadow-[0_0_12px_rgba(34,211,238,0.6)]">
          EVENT MATRIX
        </h2>
        <p class="text-[11px] text-cyan-400/70 mt-0.5">REGISTER NODE PARAMETERS</p>
      </div>

      <!-- Registration Form -->
      <form class="space-y-4" id="form">

        <!-- Input 1 -->
        <div>
          <label class="block text-[10px] font-bold text-cyan-300 uppercase tracking-widest mb-1 flex justify-between">
            <span>[01] Full Name</span>
            <span class="text-cyan-500/60">REQ</span>
          </label>
          <input type="text" placeholder="Caroline" required id="userName"
            class="w-full bg-slate-900/90 border border-cyan-500/40 rounded-lg px-3.5 py-2.5 text-xs text-cyan-100 placeholder-slate-600 focus:outline-none focus:border-cyan-300 focus:ring-1 focus:ring-cyan-300 focus:shadow-[0_0_20px_rgba(34,211,238,0.4)] transition-all" />
        </div>

        <!-- Input 2 -->
        <div>
          <label class="block text-[10px] font-bold text-cyan-300 uppercase tracking-widest mb-1 flex justify-between">
            <span>[02] Roll Number</span>
            <span class="text-cyan-500/60">REQ</span>
          </label>
          <input type="text" placeholder="251cv153" required id="userRollNumber"
            class="w-full bg-slate-900/90 border border-cyan-500/40 rounded-lg px-3.5 py-2.5 text-xs text-cyan-100 placeholder-slate-600 focus:outline-none focus:border-cyan-300 focus:ring-1 focus:ring-cyan-300 focus:shadow-[0_0_20px_rgba(34,211,238,0.4)] transition-all" />
        </div>

        <!-- Input 3 -->
        <div>
          <label class="block text-[10px] font-bold text-cyan-300 uppercase tracking-widest mb-1 flex justify-between">
            <span>[03] Event </span>
            <span class="text-cyan-500/60">REQ</span>
          </label>
          <select name="choices"   required id="userEvent"
            class="w-full bg-slate-900/90 border border-cyan-500/40 rounded-lg px-3.5 py-2.5 text-xs text-cyan-100 placeholder-slate-600 focus:outline-none focus:border-cyan-300 focus:ring-1 focus:ring-cyan-300 focus:shadow-[0_0_20px_rgba(34,211,238,0.4)] transition-all">
            <option value="hackathon event" >Hackathon event</option>
            <option value="beach event">Beach event</option>
          </select>
        </div>

        <!-- Input 4 -->
        <div>
          <label class="  text-[10px] font-bold text-cyan-300 uppercase tracking-widest mb-1 flex justify-between">
            <span>[04] College Email ID</span>
            <span class="text-cyan-500/60">REQ</span>
          </label>
          <input type="email" placeholder="caroline@nitk.edu.in" name="email" required id="userMail"
            class="w-full bg-slate-900/90 border border-cyan-500/40 rounded-lg px-3.5 py-2.5 text-xs text-cyan-100 placeholder-slate-600 focus:outline-none focus:border-cyan-300 focus:ring-1 focus:ring-cyan-300 focus:shadow-[0_0_20px_rgba(34,211,238,0.4)] transition-all" />
        </div>

        <!-- Neon Submit Button -->
        <button type="button"    id="payBtn"
          class="relative w-full mt-2 py-3 px-6 bg-cyan-950 border-2 border-cyan-400 text-cyan-200 font-['Orbitron'] font-bold text-xs tracking-widest uppercase transition-all duration-300 hover:bg-cyan-400 hover:text-black hover:shadow-[0_0_30px_rgba(34,211,238,0.9)] active:scale-[0.98] cursor-pointer flex items-center justify-center gap-2 shadow-[0_0_15px_rgba(34,211,238,0.3)]">
          <span>Pay na</span>
          <span class="text-sm">➔</span>
        </button>

      </form>

      <!-- Footer Status -->
      <div class="mt-6 pt-3 border-t border-cyan-500/30 flex items-center justify-between text-[9px] text-cyan-400/80">
        <span class="flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span> BUS_CLK: 4.8GHZ
        </span>
        <span>OUTWARD_SPARKS: ACTIVE</span>
      </div>

    </div>
  </div>
 

  <script src="./formScript.js"> </script>

</body>
</html>